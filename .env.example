# --- Copy values into .env.local (dev) and Vercel → Project → Settings → Environment Variables (production) ---

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional (only needed for local CLI / migrations)
# SUPABASE_DB_PASSWORD=

# --- Phone alerts FIRST — free texts via your mobile carrier (no Twilio) ---
# Carriers deliver SMS when we email their gateway address. Gmail below is only the send pipe.
# Verizon:  10digit@vtext.com
# AT&T:     10digit@txt.att.net
# T-Mobile: 10digit@tmomail.net
# Example: 6143778297@vtext.com
MERCHANT_SMS_GATEWAY_EMAIL=
#
# Minimal send pipe (required for carrier texts — not the same as full order email setup):
# 1. Google account → 2-Step Verification → App Password at myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Order email (optional for now — do after phone alerts) ---
# Option B — any other SMTP provider (SendGrid SMTP, Mailgun SMTP, your own server).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
#
# Option C — Postmark HTTP API. Production-grade; needs verified sender or domain.
POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound
#
# Friendly From header (optional). Defaults to "Kintampo African Market <GMAIL_USER>".
# Required for Postmark.
EMAIL_FROM=
#
# Where the store's "new order" alert email goes (you). Use the same Gmail you send from.
# Example: kkras5050@gmail.com
MERCHANT_ORDER_EMAIL=

# Shown on the site (footer, feedback page). Defaults to kkras5050@gmail.com if unset.
NEXT_PUBLIC_SUPPORT_EMAIL=

# WhatsApp order line (digits or +E.164). Defaults to the primary store phone.
# NEXT_PUBLIC_WHATSAPP_NUMBER=6143778297

# Optional: feedback form deliveries (defaults to MERCHANT_ORDER_EMAIL).
# FEEDBACK_TO_EMAIL=

# Public site URL — no trailing slash. Set on Vercel to your production domain (e.g. https://your-app.vercel.app).
# Required for Supabase email links (password reset, magic link, signup) and Stripe redirects
# so redirects never point at localhost. Also used for sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=

# Google Search Console — HTML tag verification only (not the Analytics ID).
# Search Console → Settings → Ownership verification → HTML tag → copy the content= value.
GOOGLE_SITE_VERIFICATION=

# --- US checkout address (pick ONE — easiest first) ---
#
# EASIEST (recommended): Geoapify — free ~3000 searches/day, no Google billing maze.
# 1) https://myprojects.geoapify.com/ → sign up → create project → copy API key
# 2) Vercel env: GEOAPIFY_API_KEY=your_key → redeploy
GEOAPIFY_API_KEY=
#
# OPTIONAL: Google Places API (New) — NOT the old Maps JS dropdown; needs billing account
# + enable "Places API (New)" in Google Cloud. Harder setup than Geoapify.
# GOOGLE_PLACES_API_KEY=
#
# With NO keys: strict US fallback still runs; fake addresses blocked at payment via Census.

# Stripe — test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Publishable key (pk_test_…) — required for embedded card form (Payment Element) in the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (starts with whsec_) from the SNAPSHOT event destination only.
# URL: https://YOUR-DOMAIN/api/stripe/webhook — subscribe to:
#   payment_intent.succeeded, checkout.session.completed
# Do NOT use the thin-payload whsec; this app expects classic snapshot events.
STRIPE_WEBHOOK_SECRET=
#
# Apple Pay on iPhone: register your live domain once (Dashboard → Settings → Apple Pay,
# or run: node --env-file=.env.vercel.production scripts/ops/register-stripe-apple-pay-domains.mjs)
# Test on your production Vercel URL in Safari with a card in Wallet.

# Optional: show "Continue with Google" on login/signup. Set to 1 after enabling Google in Supabase → Authentication → Providers.
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=1

# Admin auth — gate the /admin dashboard.
# On Vercel, define ADMIN_PASSWORD for each environment you actually open in the browser:
# Production *and* Preview (and Development if you use `vercel dev`). Preview URLs do not see Production-only variables.
# Set ADMIN_PASSWORD to a strong secret used at /admin/login.
# Set ADMIN_SESSION_SECRET to a long random value (>= 32 chars). Required in production —
# do not rely on ADMIN_PASSWORD for signing sessions (rotating password would invalidate sessions).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional emergency bypass only — leave unset in production.
# When unset / not "1", every admin route requires the signed cookie from POST /api/admin/login.
# ADMIN_ALLOW_SUPABASE_ROLE=1

# Admin login lockouts: paused until you set this to 1 (after testing).
# ADMIN_ENFORCE_LOGIN_RATE_LIMIT=1
# ADMIN_DISABLE_LOGIN_RATE_LIMIT=1
#
# Distributed admin login rate limit (recommended on Vercel — free tier at https://upstash.com).
# Without these, failed-login throttling is per-server instance only (weaker on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Reporting timezone for dashboard calendar buckets (IANA). Columbus OH default.
# STORE_REPORT_TIMEZONE=America/New_York

# Ohio sales tax at Columbus store rate on taxable categories (Cosmetics, Non food). Default 7.75%.
# STORE_SALES_TAX_RATE=0.0775
# NEXT_PUBLIC_STORE_SALES_TAX_RATE=0.0775

# Optional dev-only: comma-separated LAN IPs allowed to load assets from `next dev`.
# DEV_PHONE_HOSTS=192.168.1.105

# --- Shipping labels ---
# Preferred: Shippo one-click USPS labels from the order page.
# SHIPPO_API_TOKEN=

# --- Shipping (USPS business account) ---
# Checkout address verify + optional one-click labels use the same developer.usps.com app.
# Enable the Addresses API product on your app (OAuth scope: addresses).
# One-click labels: USPS Labels API v3 (developer.usps.com) + EPS payment account.
# Manual fallback: Click-N-Ship + paste tracking in admin (no vars below needed).
#
# USPS_API_CLIENT_ID=          # Consumer Key from developer.usps.com app
# USPS_API_CLIENT_SECRET=      # Consumer Secret
# USPS_EPS_ACCOUNT_NUMBER=     # Enterprise Payment System account number
# USPS_CRID=                   # Customer Registration ID (BCG)
# USPS_MID=                    # Mailer ID
# USPS_MANIFEST_MID=           # optional — defaults to USPS_MID
# USPS_MAIL_CLASS=USPS_GROUND_ADVANTAGE
# USPS_API_USE_TEST=1          # optional — use apis-tem.usps.com sandbox
# USPS_LABELS_ENABLED=1        # set after apisupport@usps.gov approves Labels API (unlocks Print in admin tab)
# Ship-from for labels + packing slips:
SHIP_FROM_NAME=Kintampo African Market
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=Columbus
SHIP_FROM_STATE=OH
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
# Default box if you don't change it per order (medium grocery box):
SHIP_DEFAULT_WEIGHT_LB=3
SHIP_DEFAULT_LENGTH_IN=12
SHIP_DEFAULT_WIDTH_IN=10
SHIP_DEFAULT_HEIGHT_IN=8

# Public auth/checkout/tracking and admin login require distributed rate limits in production.
# Use a separate Upstash database for development. Missing production Redis fails closed.
